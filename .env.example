# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID
CLIENT_ID=your_client_id_here

# Discord Guild (Server) ID
GUILD_ID=your_guild_id_here

# MongoDB Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/lostark-bot

# Channel IDs (fill after creating channels in Discord)
ORDERS_CHANNEL_ID=your_orders_channel_id
TICKETS_CATEGORY_ID=your_tickets_category_id
LOGS_CHANNEL_ID=your_logs_channel_id

# Role IDs (fill with your Discord role IDs)
ADMIN_ROLE_ID=your_admin_role_id
STAFF_ROLE_ID=your_staff_role_id
MAIL_GOLD_ROLE_ID=your_mail_gold_role_id

# Server Role IDs (one per Lost Ark server)
ROLE_GIENAH=your_gienah_role_id
ROLE_ARCTURUS=your_arcturus_role_id
ROLE_RATIK=your_ratik_role_id
ROLE_ELPON=your_elpon_role_id
ROLE_ORTUUS=your_ortuus_role_id
